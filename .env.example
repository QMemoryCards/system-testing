# Copy to .env before running docker compose locally. Never commit .env.
POSTGRES_DB=memory_cards
POSTGRES_USER=user
POSTGRES_PASSWORD=change_me
CORS_ORIGIN_PATTERNS=http://frontend,http://localhost:*,http://localhost,http://127.0.0.1:*,http://127.0.0.1
BACKEND_IMAGE=ghcr.io/qmemorycards/backend:latest
FRONTEND_IMAGE=ghcr.io/qmemorycards/frontend:latest
BACKEND_PUBLISHED_PORT=8080
FRONTEND_PUBLISHED_PORT=80
COMPOSE_PROJECT_NAME=qmemorycards-test
